# ROS2 build artifacts
ws_ros2/build/
ws_ros2/install/
ws_ros2/log/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Model files - handled by Git LFS for models/ directory
# Exclude stray model files outside models/
# models/*.pt, *.engine, etc are tracked via LFS (see .gitattributes)

# Dataset files (too large even for LFS - use external storage)
data/train/
data/test/
data/valid/
data/sample.mp4
data/degradation_preview/
data/*.yaml
data/README.*.txt

# Rosbags - LFS tracks *.db3 and *.mcap files
# Large training rosbag collections should use external storage
# Small sample/test rosbags can go in data/rosbags/ via LFS
data/samples/camera_validation_sample/  # 1.3GB sample - external storage

# Benchmark raw outputs (keep summaries in data/analysis/)
benchmark_results/

# External ROS2 packages (cloned separately)
ws_ros2/src/px4_msgs/
